<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="stable" value="../packages" />
    <add key="samples" value="packages" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="stable">
      <package pattern="BlackThunder.BlackboxSystem" />
      <package pattern="BlackThunder.UniTest" />
    </packageSource>
    <packageSource key="samples">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <auditSources>
    <clear />
  </auditSources>
</configuration>
