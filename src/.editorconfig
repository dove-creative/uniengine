# IDE0130: 네임스페이스가 폴더 구조와 일치하지 않습니다.
dotnet_diagnostic.IDE0130.severity = none

# IDE0330: 'System.Threading.Lock' 사용
dotnet_diagnostic.IDE0330.severity = none

# IDE0021: 생성자에 블록 본문 사용
