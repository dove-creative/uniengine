<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
    <StartupObject>BlackThunder.UniEngine.Tests.InfrastructureProgram</StartupObject>
    <!-- The benchmarks are a separate executable project with their own build output. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);02-Core/02-E.3-EventStream/Benchmarks/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BlackThunder.UniTest" Version="[0.4.3]" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/UniEngine.csproj" />
  </ItemGroup>
</Project>
