<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- run.ps1 points this at the library of a baseline commit to build the same benchmarks against it. -->
    <UniEngineProject Condition="'$(UniEngineProject)' == ''">$(MSBuildThisFileDirectory)../../../../src/UniEngine.csproj</UniEngineProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(UniEngineProject)" />
  </ItemGroup>
</Project>
